# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real credentials.

# --- Required ---

# Your Intervals.icu API key (Settings > Developer on intervals.icu).
INTERVALS_API_KEY=your_api_key_here

# Your Intervals.icu athlete ID, e.g. "i12345678".
# Use "0" to mean "the owner of the API key".
INTERVALS_ATHLETE_ID=your_athlete_id_here

# --- Optional ---

# Athlete local timezone as an IANA name. Default: UTC (used if left unset).
# Affects "today" and Mon–Sun week boundaries. Uncomment and set yours:
# ATHLETE_TIMEZONE=Asia/Tokyo
# ATHLETE_TIMEZONE=America/New_York
# ATHLETE_TIMEZONE=Europe/London

# Transport: "stdio" (default, for local Claude Desktop) or "http" (Streamable HTTP).
# MCP_TRANSPORT=stdio

# Port for HTTP transport. Default: 8080.
# MCP_PORT=8080

# Stream cache directory. ABSOLUTE path recommended — the working directory
# differs across clients/hosts (Claude Desktop, Codex, Linux server), so a
# relative path would resolve to a different cache per client.
# If unset, defaults to <server install>/cache/streams (resolved from the
# server's own location, not the launch directory).
# CACHE_DIR=/Users/you/Intervals-MCP-Server/cache/streams      # macOS example
# CACHE_DIR=/home/you/Intervals-MCP-Server/cache/streams       # Linux example

# Initial on/off state of the stream cache. Default: true.
# Set to false to always fetch streams fresh (no disk reads or writes). You can also
# flip this at runtime from the chat via the set_cache_enabled tool; that runtime
# change resets to this value on restart.
# CACHE_ENABLED=true

# Read-only mode. Default: false. Set to true to withhold the account-writing
# tools (create_events / update_event / delete_event / delete_events, plus the gear
# and CI-table writers) — nothing can write to your Intervals.icu account.
# Local-only tools (clear_cache / set_cache_enabled) stay available.
# This is a local mitigation; the API key itself still grants full account access.
# See SECURITY.md.
# READ_ONLY=false

# --- Activity custom fields ---
# If you followed the Wiki field recipes exactly, all of these work at their defaults
# without any configuration. Only set them if your field codes differ from the defaults.
# Field recipes: https://github.com/methylone/Intervals-MCP-Server-with-STRYD/wiki/LLM-Agent-Recipes
#
# LBSS custom-field code (CamelCase, no underscore). Default StrydLBSSv2.
# If your account only has the community StrydLBSSmod field, either build StrydLBSSv2
# from the Wiki recipe or set LBSS_FIELD=StrydLBSSmod.
# LBSS_FIELD=StrydLBSSv2
#
# Eccentric (downhill) LBSS field, reported when a tool is called with include_ecc=true
# (get_weekly_summary / get_phase_summary / search_similar_activities). Default EccLBSS.
# Set to an empty value to disable include_ecc entirely.
# ECC_FIELD=EccLBSS

# --- Streams ---
# If you followed the Wiki field recipes exactly, all of these work at their defaults
# without any configuration. Only set them if your stream codes differ from the defaults.
#
# ILR custom-field code (CamelCase, no underscore). Default StrydILR.
# ILR_FIELD=StrydILR
#
# Extra Intervals.icu custom stream codes to fetch and surface as per-split averages in
# get_activity_streams_summary (extras / extras_run / run_fraction output). Comma-separated
# list of CamelCase codes. Default: "" (disabled).
# Each code must match a custom stream mapped in Intervals.icu Settings (Developer >
# Custom Streams). Recommended values after following the Wiki stream setup:
# EXTRA_STREAM_FIELDS=StrydLSS,StrydTemp,StrydHumidity
